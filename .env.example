# Wiz service account credentials (Settings > Service Accounts in the Wiz console)
WIZ_CLIENT_ID=
WIZ_CLIENT_SECRET=

# Wiz auth token endpoint, tenant-specific. Common values:
#   https://auth.app.wiz.io/oauth/token
#   https://auth0.gov.wiz.io/oauth/token
WIZ_AUTH_URL=https://auth.app.wiz.io/oauth/token

# Wiz GraphQL API endpoint, tenant-specific, e.g. https://api.us1.app.wiz.io/graphql
WIZ_API_URL=
